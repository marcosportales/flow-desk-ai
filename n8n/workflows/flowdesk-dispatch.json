    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000010",
      "name": "Deliver to notifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 300],
      "onError": "continueRegularOutput",
      "retryOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFIER_URL }}/deliveries",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Idempotency-Key", "value": "={{ $json.dispatch_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, message: $json.message }) }}",
        "options": {
          "timeout": 10000,
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      }
    },
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000011",
      "name": "Build callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Reports the delivery outcome, signed with N8N_TO_FLOWDESK_SECRET\n// (IMPLEMENTATION.md §4.5). Retries are the app's job (ADR 0006).\nconst crypto = require('crypto');\nconst event = $('Validate payload').first().json;\nconst res = $input.first().json;\nconst status = res.statusCode;\nconst ok = !res.error && status >= 200 && status < 300;\nlet error = null;\nif (!ok) {\n  error = res.error\n    ? String(res.error.message || JSON.stringify(res.error))\n    : `notifier answered HTTP ${status}`;\n}\nconst body = JSON.stringify({\n  dispatch_id: event.dispatch_id,\n  outcome: ok ? 'succeeded' : 'failed',\n  error,\n  n8n_execution_id: String($execution.id),\n  delivered_at: ok ? (res.body && res.body.received_at) || new Date().toISOString() : null,\n});\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto\n  .createHmac('sha256', $env.N8N_TO_FLOWDESK_SECRET)\n  .update(timestamp + '.' + body)\n  .digest('hex');\nreturn [{ json: { callback_url: event.callback_url, body, timestamp, signature } }];\n"
      }
    },
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000012",
      "name": "Callback to app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 300],
      "parameters": {
