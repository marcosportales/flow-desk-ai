  "nodes": [
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000001",
      "name": "Dispatch webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 300],
      "webhookId": "5d3f7c2a-8a51-4c43-9d7e-2f2a6f0e9b01",
      "parameters": {
        "httpMethod": "POST",
        "path": "flowdesk-dispatch",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true,
          "responseCode": { "values": { "responseCode": "customCode", "customCode": 202 } }
        }
      }
    },
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000002",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// HMAC-SHA256 over `timestamp.rawBody` with FLOWDESK_TO_N8N_SECRET\n// (IMPLEMENTATION.md §4.4). A mismatch throws: the execution fails and\n// no callback is sent.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers;\nconst timestamp = headers['x-flowdesk-timestamp'];\nconst signature = headers['x-flowdesk-signature'] || '';\nconst raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n\nconst seconds = Number(timestamp);\nif (!Number.isInteger(seconds) || Math.abs(Date.now() - seconds * 1000) > 5 * 60 * 1000) {\n  throw new Error('stale or missing timestamp');\n}\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', $env.FLOWDESK_TO_N8N_SECRET)\n  .update(timestamp + '.' + raw)\n  .digest('hex');\nconst a = Buffer.from(signature);\nconst b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  throw new Error('bad signature');\n}\nreturn [{ json: JSON.parse(raw) }];\n"
      }
    },
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000003",
      "name": "Validate payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The app has already decided everything; this only rejects a malformed\n// event before any side effect.\nconst e = $input.first().json;\nconst oneOf = (value, allowed, field) => {\n  if (!allowed.includes(value)) throw new Error(`invalid ${field}: ${value}`);\n};\nfor (const field of ['dispatch_id', 'callback_url']) {\n  if (typeof e[field] !== 'string' || e[field] === '') throw new Error(`missing ${field}`);\n}\nif (!e.ticket || typeof e.ticket.number !== 'string' || typeof e.ticket.title !== 'string') {\n  throw new Error('missing ticket');\n}\noneOf(e.category, ['erp', 'access', 'data'], 'category');\noneOf(e.priority, ['urgent', 'high', 'normal', 'low'], 'priority');\noneOf(e.team, ['it_systems', 'identity_access', 'data_team'], 'team');\noneOf(e.route, ['standard', 'urgent'], 'route');\nreturn [{ json: e }];\n"
      }
    },
    {
      "id": "6b1d3c1e-0f0a-4a51-9f3e-000000000004",
      "name": "Switch on Team",
      "type": "n8n-nodes-base.switch",
